# Host ports used by Docker Compose.
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
# Read-only registry and deployment-time default used by the orchestrator.
MODEL_CONTAINERS=yolo=http://yolo-model:8001,ssd=http://ssd-model:8002
# Change to ssd to replace the default model without changing application code.
DEFAULT_MODEL_ID=yolo
MODEL_REQUEST_TIMEOUT_SECONDS=30
TARGET_FPS=1
MAX_LATENCY_MS=1000
FRAME_QUEUE_CAPACITY=8
FRAME_SAMPLE_EVERY_N=1
YOLO_MODEL_PORT=8001
YOLO_MODEL_NAME=yolo11n
YOLO_MODEL_VERSION=yolo11n
YOLO_WEIGHTS_VOLUME=adaptive-neural-platform-yolo-weights
# Compose stores /models/yolo11n.pt in the adaptive-neural-platform-yolo-weights volume.

# SSDLite service configuration and persistent weights volume.
SSD_MODEL_PORT=8002
SSD_MODEL_NAME=ssdlite320-mobilenet-v3-large
SSD_MODEL_VERSION=torchvision-coco-v1
SSD_SCORE_THRESHOLD=0.5
SSD_WEIGHTS_VOLUME=adaptive-neural-platform-ssd-weights
